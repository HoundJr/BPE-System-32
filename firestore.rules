rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // v1: any logged-in user (i.e. you) can read/write everything.
    // Tighten to a specific UID (request.auth.uid == "...") before handing
    // this off to anyone else.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
